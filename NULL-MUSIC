--==================================================
-- UNIQUE FILE NAME
--==================================================

local function MakeFileName(Url)

    local Hash = 0

    for i = 1, #Url do

        Hash = (
            Hash * 31 +
            string.byte(Url, i)
        ) % 2147483647

    end

    return "NULLMUSIC_V10_" .. tostring(Hash) .. ".mp3"

end

--==================================================
-- GET ASSET
--==================================================

local function GetAsset(Data)

    if not Data then
        return ""
    end

    if Data.AssetId and Data.AssetId ~= "" then
        return Data.AssetId
    end

    local Url = Data.Url

    if not Url or Url == "" then
        return ""
    end

    if AssetCache[Url] then
        return AssetCache[Url]
    end

    local GetAssetFunc =
        getcustomasset or
        getsynasset

    if writefile and readfile and GetAssetFunc then

        local FileName = MakeFileName(Url)

        local Exists = false

        pcall(function()

            readfile(FileName)
            Exists = true

        end)

        if not Exists then

            local Success, Content = pcall(function()

                return game:HttpGet(Url)

            end)

            if Success and Content and #Content > 0 then

                pcall(function()

                    writefile(FileName, Content)

                end)

            end

        end

        local Success, Asset = pcall(function()

            return GetAssetFunc(FileName)

        end)

        if Success and Asset and Asset ~= "" then

            AssetCache[Url] = Asset

            return Asset

        end

    end

    AssetCache[Url] = Url

    return Url

end

--==================================================
-- LOAD SONG
--==================================================

local function LoadSong(Index, AutoPlay)

    local Songs = Music[CurrentTab]
    local Data = Songs[Index]

    if not Data then
        return
    end

    CurrentIndex = Index
    CurrentSong.Text = "♪ " .. Data.Name

    LoadToken += 1

    local MyToken = LoadToken
    local MyTab = CurrentTab
    local MyIndex = Index

    Sound:Stop()

    Playing = false
    Play.Text = "▶"

    task.spawn(function()

        local Asset = GetAsset(Data)

        if MyToken ~= LoadToken then
            return
        end

        if CurrentTab ~= MyTab then
            return
        end

        if CurrentIndex ~= MyIndex then
            return
        end

        if not Asset or Asset == "" then
            return
        end

        Sound:Stop()
        Sound.SoundId = Asset
        Sound.Volume = Volume
        Sound.PlaybackSpeed = Speed

        if AutoPlay then

            task.wait()

            if MyToken ~= LoadToken then
                return
            end

            Sound:Play()

            Playing = true
            Play.Text = "Ⅱ"

        end

    end)

end

