local function MakeLight(Color, X, Clickable)

    local Light

    if Clickable then

        Light = Instance.new("TextButton")
        Light.Text = ""
        Light.AutoButtonColor = false
        Light.BackgroundTransparency = 1
        Light.Size = UDim2.fromOffset(20, 20)
        Light.Position = UDim2.fromOffset(X - 4, 16)

    else

        Light = Instance.new("Frame")
        Light.Size = UDim2.fromOffset(11, 11)
        Light.Position = UDim2.fromOffset(X, 21)

    end

    Light.Name = Clickable and "RedSettingsButton" or "Light"
    Light.BackgroundColor3 = Color
    Light.BorderSizePixel = 0
    Light.ZIndex = 30
    Light.Parent = Header

    local Circle

    if Clickable then

        Circle = Instance.new("Frame")
        Circle.Size = UDim2.fromOffset(11, 11)
        Circle.Position = UDim2.fromOffset(4, 4)
        Circle.BackgroundColor3 = Color
        Circle.BorderSizePixel = 0
        Circle.ZIndex = 31
        Circle.Parent = Light

    else

        Circle = Light

    end

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0)
    Corner.Parent = Circle

    return Light, Circle
end

