    if not Data then
        return
    end

    if (not Data.Url or Data.Url == "")
        and
       (not Data.AssetId or Data.AssetId == "") then

        return
    end

    if Playing then

        Sound:Pause()

        Playing = false
        Play.Text = "▶"

        return

    end

    if Sound.SoundId == "" then

        LoadSong(CurrentIndex, true)

        return

    end

    if Sound.TimePosition > 0 then

        Sound:Resume()

    else

        Sound:Play()

    end

    Playing = true
    Play.Text = "Ⅱ"

end)

