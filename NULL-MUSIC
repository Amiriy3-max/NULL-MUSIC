local function OpenBigMenu()

    Mini.Visible = false
    Main.Visible = true

    local FinalSize =
        UDim2.fromOffset(390, 315)

    Main.Size =
        UDim2.fromOffset(150, 44)

    TweenService:Create(
        Main,
        TweenInfo.new(
            0.28,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = FinalSize
        }
    ):Play()

end

local function MinimizeMenu()

    HideSidePanels()

    Main.Visible = false

    Mini.Size =
        UDim2.fromOffset(15, 15)

    Mini.Visible = true

    TweenService:Create(
        Mini,
        TweenInfo.new(
            0.24,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.fromOffset(148, 42)
        }
    ):Play()

end

CloseButton.MouseButton1Click:Connect(function()

    MinimizeMenu()

end)

Mini.MouseButton1Click:Connect(function()

    OpenBigMenu()

end)

