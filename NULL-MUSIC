--==================================================
-- CONTRAST
--==================================================

local function GetTextColor(Color)

    local R = Color.R
    local G = Color.G
    local B = Color.B

    local Brightness =
        (R * 0.299) +
        (G * 0.587) +
        (B * 0.114)

    if Brightness > 150 then
        return Color3.fromRGB(0, 0, 0)
    end

    return WHITE
end

local function Darken(Color)

    return Color3.fromRGB(
        math.floor(Color.R * 255 * 0.48),
        math.floor(Color.G * 255 * 0.48),
        math.floor(Color.B * 255 * 0.48)
    )

end

--==================================================
-- APPLY THEME
--==================================================

local function ApplyTheme(Color)

    ThemeColor = Color
    ThemeDark = Darken(Color)
    ThemeText = GetTextColor(Color)

    -- registered red elements
    for _, Item in ipairs(ThemeObjects) do

        if Item.Object and Item.Object.Parent then

            pcall(function()

                if Item.Property == "TextColor3" then

                    Item.Object[Item.Property] = ThemeText

                elseif Item.Property == "BackgroundColor3" then

                    Item.Object[Item.Property] = ThemeColor

                else

                    Item.Object[Item.Property] = ThemeColor

                end

            end)

        end

    end

    -- exact theme colors
    MainStroke.Color = ThemeColor
    Glow.Color = ThemeColor

    HeaderStroke.Color = ThemeDark

    Title.TextColor3 = ThemeColor
    Title.TextStrokeColor3 = ThemeDark

    LockStroke.Color = ThemeColor
    CloseButton.TextColor3 = ThemeColor
    CloseStroke.Color = ThemeColor

    -- RED LIGHT ONLY
    RedCircle.BackgroundColor3 = ThemeColor

    -- mini
    MiniStroke.Color = ThemeColor
    LeftLine.BackgroundColor3 = ThemeColor
    RightLine.BackgroundColor3 = ThemeColor

    -- tab colors
    for Name, Button in pairs(TabButtons) do

        local Stroke = Button:FindFirstChildOfClass("UIStroke")

        if Stroke then
            Stroke.Color = ThemeDark
        end

        if Name == CurrentTab then
            Button.BackgroundColor3 = Darken(ThemeColor)
            Button.TextColor3 = ThemeText
        else
            Button.BackgroundColor3 = DARK2
            Button.TextColor3 = WHITE
        end

    end

    -- player buttons
    PrevStroke.Color = ThemeColor
    NextStroke.Color = ThemeColor
    PlayStroke.Color = ThemeColor

    Play.TextColor3 = ThemeColor
    Play.BackgroundColor3 = Darken(ThemeColor)

    -- settings
    SettingsStroke.Color = ThemeColor
    SettingsHeader.BackgroundColor3 = ThemeDark
    SettingsTitle.TextColor3 = ThemeText

    VolumeTitle.TextColor3 = ThemeColor
    SpeedTitle.TextColor3 = ThemeColor

    for Value, Button in pairs(SpeedButtons) do

        local Stroke = Button:FindFirstChildOfClass("UIStroke")

        if Stroke then
            Stroke.Color = ThemeDark
        end

        if Value == Speed then
            Button.BackgroundColor3 = ThemeColor
            Button.TextColor3 = ThemeText
        else
            Button.BackgroundColor3 = DARK2
            Button.TextColor3 = WHITE
        end

    end

    -- BG panel
    BGStroke.Color = ThemeColor
    BGHeader.BackgroundColor3 = ThemeDark
    BGTitle.TextColor3 = ThemeText
    BGScroll.ScrollBarImageColor3 = ThemeColor
    BlackBGStroke.Color = ThemeColor

    -- color panel
    ColorStroke.Color = ThemeColor
    ColorHeader.BackgroundColor3 = ThemeDark
    ColorTitle.TextColor3 = ThemeText

end

